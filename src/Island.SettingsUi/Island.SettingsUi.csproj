<Project Sdk="Microsoft.NET.Sdk">

  <!-- The settings screen as a library: the glass view only. It never touches files or Windows;
       the app owns a SettingsSession (Island.Core) and hands it to the view. -->
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Island.SettingsUi.Smoke" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Island.Core\Island.Core.csproj" />
  </ItemGroup>

</Project>
