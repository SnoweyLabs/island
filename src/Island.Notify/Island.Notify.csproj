<Project Sdk="Microsoft.NET.Sdk">

  <!-- The program an agent's hook runs. A console program with no window and no packages; it always ends with code 0. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>Island.Notify</AssemblyName>
    <RootNamespace>Island.Notify</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <InvariantGlobalization>true</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Island.Core\Island.Core.csproj" />
  </ItemGroup>

</Project>
