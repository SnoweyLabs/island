<Project Sdk="Microsoft.NET.Sdk">

  <!-- Draws the settings screen off screen to PNG files and prints counts. No window is ever shown.
       Not part of Island.sln. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Island.SettingsUi\Island.SettingsUi.csproj" />
    <ProjectReference Include="..\Island.Core\Island.Core.csproj" />
  </ItemGroup>

</Project>
