{
  "manifest_version": 3,
  "name": "Island tabs",
  "version": "1.1.0",
  "description": "Tells the Island app on this computer which tabs are open and plays or pauses media tabs when asked. Talks to 127.0.0.1 only.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "key": "",
  "permissions": ["tabs", "favicon", "alarms", "storage", "scripting"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://www.youtube.com/*",
    "https://music.youtube.com/*",
    "https://www.twitch.tv/*",
    "https://soundcloud.com/*",
    "https://open.spotify.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://music.youtube.com/*",
        "https://www.twitch.tv/*",
        "https://soundcloud.com/*",
        "https://open.spotify.com/*"
      ],
      "js": ["content/media-main.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://music.youtube.com/*",
        "https://www.twitch.tv/*",
        "https://soundcloud.com/*",
        "https://open.spotify.com/*"
      ],
      "js": ["lib/sites.js", "lib/media.js", "content/media-relay.js"],
      "run_at": "document_start"
    }
  ]
}
